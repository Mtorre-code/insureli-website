---
interface Props { eyebrow: string; title: string; lead?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="hero page-hero">
  <div class="glow a" aria-hidden="true"></div>
  <div class="glow b" aria-hidden="true"></div>
  <div class="waves" aria-hidden="true">
    <svg class="w2" width="2880" height="150" viewBox="0 0 2880 150"><path d="M0 80 Q 180 30 360 80 T 720 80 T 1080 80 T 1440 80 T 1800 80 T 2160 80 T 2520 80 T 2880 80" fill="none" stroke="#64B5F6" stroke-width="3"></path></svg>
    <svg class="w1" width="2880" height="150" viewBox="0 0 2880 150"><path d="M0 100 Q 240 50 480 100 T 960 100 T 1440 100 T 1920 100 T 2400 100 T 2880 100 V150 H0 Z" fill="#1E88E5"></path></svg>
  </div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="hero-copy" style="max-width:840px">
        {crumbs && (
          <nav aria-label="Breadcrumb" class="crumbs fade-up d1">
            <a href="/">Home</a>
            {crumbs.map((c) => (<><span aria-hidden="true">/</span><a href={c.href}>{c.label}</a></>))}
          </nav>
        )}
        <p class="eyebrow fade-up d1">{eyebrow}</p>
        <h1 class="fade-up d2">{title}</h1>
        {lead && <p class="lead fade-up d3" style="font-size:19px">{lead}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>
