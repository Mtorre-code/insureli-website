---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Ready to compare your coverage?', text = 'Free, no-obligation quotes from a family-run agency.' } = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <div class="stack reveal from-left" style="gap:8px">
      <h2>{title}</h2>
      <p style="font-size:18px">{text}</p>
    </div>
    <div class="reveal from-right" style="display:flex;flex-wrap:wrap;gap:14px">
      <a href="/quote" class="btn btn-dark">Get a Free Quote <span class="arrow">→</span></a>
      <a href={site.phoneHref} class="btn btn-ghost">Call {site.phone}</a>
    </div>
  </div>
</section>
