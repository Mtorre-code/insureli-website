---
import { carriers } from '../data/site';
// Duplicate the list so the loop is seamless.
const loop = [...carriers, ...carriers];
---
<div class="marquee" aria-label="Carriers we work with">
  <ul class="marquee-track" style="list-style:none;margin:0;padding:0">
    {loop.map((c, i) => (
      <li class="carrier" aria-hidden={i >= carriers.length ? 'true' : undefined}>
        <img src={c.logo} alt={c.name} loading="lazy" />
      </li>
    ))}
  </ul>
</div>
