---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { carriers } from '../data/site';
---
<Base title="Insurance Carriers We Represent" description="As an independent agency, Insure LI compares coverage from multiple insurance carriers, including Travelers, Liberty Mutual, Chubb, Progressive and more." section="">
  <PageHero eyebrow="Our carriers" title="More choices, one local agency" lead="Captive agents can only offer one company's policies. As an independent agency, we compare multiple carriers and recommend the one that fits you best." />
  <section class="section bg-mist">
    <div class="wrap">
      <div class="grid carrier-grid stagger">
        {carriers.map((c) => (
          <a class="card carrier carrier-tile" href={c.url} target="_blank" rel="noopener noreferrer" aria-label={`${c.name}: ${c.blurb} Visit website (opens in a new tab)`}>
            <img src={c.logo} alt="" loading="lazy" />
            <span class="carrier-info" aria-hidden="true">
              <strong>{c.name}</strong>
              <span class="blurb">{c.blurb}</span>
              <span class="visit">Visit website ↗</span>
            </span>
          </a>
        ))}
      </div>
      <p class="reveal" style="text-align:center;margin-top:36px;color:var(--muted)">…and more. Hover over a carrier to learn about it. Availability depends on the type of coverage, location and underwriting.</p>
    </div>
  </section>
</Base>
