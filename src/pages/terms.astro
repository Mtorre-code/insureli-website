---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Terms of Use & Licensing" description="Terms of use and licensing disclosures for the Insure LI Agency website." cta={false}>
  <PageHero eyebrow="Legal" title="Terms of Use & Licensing" lead="Last updated November 2026" />
  <section class="section">
    <div class="wrap prose">
      <h2>Licensing</h2>
      <p>Insure LI Agency Inc. serves clients in New York, New Jersey, Connecticut, Pennsylvania and Florida. Coverage availability varies by state and carrier.</p>
      <h2>No coverage until confirmed</h2>
      <p>Submitting a form on this website does not bind, change or cancel coverage. Coverage is not in effect until confirmed in writing by our agency or the insurance company. Quotes are subject to underwriting approval.</p>
      <h2>Information on this site</h2>
      <p>Coverage descriptions on this site are general summaries for informational purposes only. They do not describe every policy, and actual coverage is governed by the terms, conditions and exclusions of the policy issued. Please contact us with questions about your specific situation.</p>
      <h2>Third-party links</h2>
      <p>This site may link to carrier or third-party websites. We are not responsible for the content or privacy practices of those sites.</p>
    </div>
  </section>
</Base>
